# Copy to .env (gitignored) and fill in your own values. Never commit .env.
# Local development and demo only. Production uses Azure Key Vault.

# --- Canvas (development and demo only) ---
CANVAS_BASE_URL=https://classroom.sdi.edu
CANVAS_ACCESS_TOKEN=

# --- Model provider (development and demo only) ---
# Options: 'fake' (default, offline), 'gemini' (Google AI Studio key), or 'azure-openai'
MODEL_PROVIDER=fake
GEMINI_API_KEY=

# --- Server Ports ---
API_PORT=3001

# --- Database ---
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/ai_tutor

# --- Demo Personas (masquerading allowlist) ---
DEMO_STUDENT_ID=1001
DEMO_INSTRUCTOR_ID=2001
DEMO_TA_ID=3001
