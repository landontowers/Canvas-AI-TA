# Copy to .env (gitignored) and fill in your own values. Never commit .env.
# Local development and demo only. Production uses Azure Key Vault.

# --- Canvas (development and demo only) ---
CANVAS_BASE_URL=https://classroom.sdi.edu
CANVAS_ACCESS_TOKEN=
# Approach 1: Connect live Canvas for identity & masquerading, but serve fake course data to the AI model (critique §3.1, §4.4)
# Set to 'true' (default) to protect FERPA & student privacy. Set to 'false' only if pointing to a dedicated synthetic Canvas sandbox course.
CANVAS_USE_FAKE_COURSE_DATA=true

# --- Model provider (development and demo only) ---
# Options: 'fake' (default, offline), 'gemini' (Google AI Studio or Vertex AI), or 'azure-openai'
MODEL_PROVIDER=fake
GEMINI_API_KEY=
# Optional: use Google Cloud Vertex AI instead of AI Studio when MODEL_PROVIDER=gemini
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Path to GCP service-account JSON inside Docker (mounted from ./secrets/gcp-sa.json)
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-sa.json
STUDENT_MODEL=gemini-3.6-flash
INSTRUCTOR_MODEL=gemini-3.6-flash
CLASSIFIER_MODEL=gemini-3.1-flash-lite

# --- Server Ports ---
API_PORT=3001

# --- Database ---
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/virtual_ta
# Set to 'postgres' to persist conversations & settings in PostgreSQL (defaults to 'memory' in local unit runs)
PERSISTENCE_MODE=memory
# Conversation retention window in days for automated/admin purge (default: 90)
DATA_RETENTION_DAYS=90

# --- Demo Personas (masquerading allowlist) ---
DEMO_STUDENT_ID=1001
DEMO_INSTRUCTOR_ID=2001
DEMO_TA_ID=3001

# --- Demo Hosting & Protection (Phase 5, critique §4.3) ---
# Set to 'true' to require demo passcode or invited email
DEMO_AUTH_ENABLED=false
DEMO_PASSWORD=
DEMO_INVITED_EMAILS=
# Optional Cloudflare Access JWT verification (e.g. myteam.cloudflareaccess.com)
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# --- LTI 1.3 Inside Canvas (Phase 6) ---
LTI_ENABLED=false
LTI_CLIENT_ID=virtual-ta-lti-client
LTI_DEPLOYMENT_ID=sdi-deployment-1
LTI_ISSUER=https://canvas.instructure.com
LTI_PLATFORM_AUTH_URL=https://classroom.sdi.edu/api/lti/authorize_redirect
LTI_PLATFORM_JWKS_URL=https://classroom.sdi.edu/api/lti/security/jwks
LTI_TOOL_PUBLIC_URL=http://localhost:5173

# --- Cloudflare Tunnel (optional for remote demo sharing, critique §4.3) ---
CLOUDFLARE_TUNNEL_TOKEN=

# --- Privacy Telemetry & Crisis Alerts (FERPA compliance & § 99.36) ---
# Secret salt for pseudonymizing user IDs into anon_<hex> hashes in operational telemetry
TELEMETRY_SALT=demo-telemetry-salt-change-in-production
# Optional webhook endpoint for emergency crisis incident alerts (FERPA 34 CFR § 99.36)
CRISIS_ALERT_WEBHOOK_URL=
CRISIS_ALERT_BEARER_TOKEN=

# --- Azure Log & Telemetry Storage (optional, critique §3.7, §5.2) ---
# Set to 'true' (or provide connection string / SAS URL) to export de-identified telemetry to Azure Blob Storage
AZURE_LOG_STORAGE_ENABLED=false
# Standard Azure Storage Account connection string:
AZURE_STORAGE_CONNECTION_STRING=
# Or direct container SAS URL (e.g. https://<account>.blob.core.windows.net/<container>?<sas>):
AZURE_STORAGE_LOG_CONTAINER_URL=
# Container name (defaults to 'telemetry-logs'):
AZURE_STORAGE_LOG_CONTAINER=telemetry-logs

# --- Phase 7 Pilot Readiness: Azure OpenAI & Canvas OAuth2 Opt-In ---
# Set MODEL_PROVIDER=azure-openai and provide endpoint/key/deployments for pilot/production
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-03-01-preview
AZURE_OPENAI_DEPLOYMENT_STUDENT=gpt-5.4-mini
AZURE_OPENAI_DEPLOYMENT_INSTRUCTOR=gpt-5.4-mini
AZURE_OPENAI_DEPLOYMENT_CLASSIFIER=gpt-5.4-nano

# Canvas OAuth2 per-user opt-in (replaces dev as_user_id masquerading in production)
CANVAS_OAUTH_ENABLED=false
CANVAS_OAUTH_CLIENT_ID=
CANVAS_OAUTH_CLIENT_SECRET=
CANVAS_OAUTH_REDIRECT_URI=http://localhost:5173/api/oauth/canvas/callback
