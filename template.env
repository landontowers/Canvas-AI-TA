# Copy to .env (gitignored) and fill in your own values. Never commit .env.
# Phases 1-2 of the implementation plan add the database URL and demo persona IDs.

# --- Canvas (development and demo only) ---
# Personal access token from Canvas > Account > Settings. Never use one in a deployed environment.
CANVAS_BASE_URL=https://classroom.sdi.edu
CANVAS_ACCESS_TOKEN=

# --- Model provider (development and demo only) ---
# Gemini API key from Google AI Studio, on your own Google account. Test data only.
GEMINI_API_KEY=
