{
  "name": "virtual-ta",
  "version": "0.1.0",
  "private": true,
  "description": "Socratic Virtual TA built into Canvas LMS",
  "license": "Apache-2.0",
  "author": "Landon Towers",
  "type": "module",
  "scripts": {
    "dev": "docker compose up --build",
    "build": "pnpm --filter @virtual-ta/core run build && pnpm --filter @virtual-ta/adapters run build && pnpm --filter @virtual-ta/api run build && pnpm --filter @virtual-ta/web run build",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm dep-check && pnpm test:coverage",
    "typecheck": "pnpm --recursive run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "eval": "vitest run packages/adapters/src/evals/evals.test.ts",
    "eval:bakeoff": "tsx packages/adapters/src/evals/eval-runner.ts",
    "dep-check": "depcruise --config .dependency-cruiser.cjs packages apps",
    "db:generate": "pnpm --filter @virtual-ta/adapters db:generate",
    "db:migrate": "pnpm --filter @virtual-ta/adapters db:migrate",
    "db:seed": "pnpm --filter @virtual-ta/adapters db:seed",
    "demo:reset": "pnpm --filter @virtual-ta/adapters demo:reset"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.9",
    "@vitest/coverage-v8": "3.2.7",
    "dependency-cruiser": "^16.10.0",
    "eslint": "^9.21.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.7"
  }
}
